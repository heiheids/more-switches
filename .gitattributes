# Normalise line endings in the repository so the shell scripts and Gradle files stay usable
# on every platform.
* text=auto

*.java    text eol=lf
*.gradle  text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.py      text eol=lf
*.ps1     text eol=crlf
*.cmd     text eol=crlf

*.png     binary
*.jar     binary
*.zip     binary
