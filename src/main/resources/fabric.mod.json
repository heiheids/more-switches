    "moreswitches.client.mixins.json"
  ],
  "entrypoints": {
    "main": [
      "com.heishandashu.moreswitches.MoreSwitchesMod"
    ],
    "client": [
      "com.heishandashu.moreswitches.client.MoreSwitchesClient"
    ]
